{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage-card.schema.json",
  "title": "StageCard (clean re-implementation)",
  "type": "object",
  "required": [
    "id",
    "utterance",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,100}$"
    },
    "utterance": {
      "type": "string",
      "maxLength": 600
    },
    "status": {
      "enum": [
        "working",
        "ready",
        "needs-you",
        "error"
      ]
    },
    "pinned": {
      "type": "boolean"
    },
    "step": {
      "type": "string",
      "maxLength": 120
    },
    "say": {
      "type": "string",
      "maxLength": 400
    },
    "receipt": {
      "type": "string",
      "maxLength": 80
    },
    "screen": {
      "type": "object",
      "required": [
        "blocks"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "blocks": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "id",
                  "type",
                  "text"
                ],
                "additionalProperties": true,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,100}$"
                  },
                  "type": {
                    "const": "answer"
                  },
                  "text": {
                    "type": "string"
                  },
                  "detail": {
                    "type": "string"
                  },
                  "sources": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 4
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "id",
                  "type",
                  "columns",
                  "rows"
                ],
                "additionalProperties": true,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,100}$"
                  },
                  "type": {
                    "const": "list"
                  },
                  "label": {
                    "type": "string"
                  },
                  "columns": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 4
                  },
                  "rows": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "maxItems": 6
                  },
                  "highlight": {
                    "type": "integer"
                  },
                  "action": {
                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "string"
                      },
                      "ask": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "id",
                  "type",
                  "value"
                ],
                "additionalProperties": true,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,100}$"
                  },
                  "type": {
                    "const": "number"
                  },
                  "label": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  },
                  "delta": {
                    "type": "string"
                  },
                  "up": {
                    "type": "boolean"
                  },
                  "series": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "v": {
                          "type": "number"
                        }
                      }
                    }
                  },
                  "source": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "id",
                  "type",
                  "bullets"
                ],
                "additionalProperties": true,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,100}$"
                  },
                  "type": {
                    "const": "brief"
                  },
                  "title": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "bullets": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "people": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "role": {
                          "type": "string"
                        },
                        "note": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "sources": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "id",
                  "type",
                  "text"
                ],
                "additionalProperties": true,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,100}$"
                  },
                  "type": {
                    "const": "note"
                  },
                  "label": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  },
                  "missing": {}
                }
              },
              {
                "type": "object",
                "required": [
                  "id",
                  "type",
                  "items"
                ],
                "additionalProperties": true,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,100}$"
                  },
                  "type": {
                    "const": "todo"
                  },
                  "label": {
                    "type": "string"
                  },
                  "total": {
                    "type": "integer"
                  },
                  "items": {
                    "type": "array",
                    "maxItems": 6,
                    "$comment": "kit.js: if any item has a string 'title' the block renders as a numbered Needs-you list (title/detail/action); otherwise as people rows (who/text/...).",
                    "items": {
                      "anyOf": [
                        {
                          "type": "object",
                          "required": [
                            "id",
                            "title"
                          ],
                          "properties": {
                            "id": {
                              "type": "string"
                            },
                            "title": {
                              "type": "string"
                            },
                            "detail": {
                              "type": "string"
                            },
                            "action": {
                              "type": "string"
                            }
                          }
                        },
                        {
                          "type": "object",
                          "required": [
                            "text"
                          ],
                          "properties": {
                            "id": {
                              "type": "string"
                            },
                            "who": {
                              "type": "string"
                            },
                            "text": {
                              "type": "string"
                            },
                            "org": {
                              "type": "string"
                            },
                            "source": {
                              "type": "string"
                            },
                            "person": {
                              "type": "boolean"
                            },
                            "age": {
                              "type": "string"
                            },
                            "unit": {
                              "type": "string"
                            },
                            "state": {
                              "enum": [
                                "",
                                "done",
                                "failed"
                              ]
                            },
                            "replyable": {
                              "type": "boolean"
                            }
                          }
                        }
                      ]
                    }
                  },
                  "empty": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "id",
                  "type",
                  "items"
                ],
                "additionalProperties": true,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,100}$"
                  },
                  "type": {
                    "const": "agenda"
                  },
                  "label": {
                    "type": "string"
                  },
                  "items": {
                    "type": "array",
                    "maxItems": 8,
                    "items": {
                      "type": "object",
                      "required": [
                        "time",
                        "title"
                      ],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "time": {
                          "type": "string"
                        },
                        "title": {
                          "type": "string"
                        },
                        "meta": {
                          "type": "string"
                        },
                        "state": {
                          "enum": [
                            "",
                            "done",
                            "next",
                            "conflict",
                            "moved",
                            "new"
                          ]
                        }
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "id",
                  "type",
                  "name"
                ],
                "additionalProperties": true,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,100}$"
                  },
                  "type": {
                    "const": "person"
                  },
                  "name": {
                    "type": "string"
                  },
                  "role": {
                    "type": "string"
                  },
                  "org": {
                    "type": "string"
                  },
                  "note": {
                    "type": "string"
                  },
                  "facts": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "l": {
                          "type": "string"
                        },
                        "v": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "id",
                  "type",
                  "kind",
                  "title"
                ],
                "additionalProperties": true,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,100}$"
                  },
                  "type": {
                    "const": "created"
                  },
                  "kind": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "detail": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "id",
                  "type",
                  "steps"
                ],
                "additionalProperties": true,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,100}$"
                  },
                  "type": {
                    "const": "progress"
                  },
                  "steps": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "text": {
                          "type": "string"
                        },
                        "state": {
                          "enum": [
                            "done",
                            "active",
                            "pending",
                            "failed"
                          ]
                        }
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "id",
                  "type",
                  "provider"
                ],
                "additionalProperties": true,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,100}$"
                  },
                  "type": {
                    "const": "connect"
                  },
                  "provider": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "state": {
                    "enum": [
                      "",
                      "idle",
                      "connecting",
                      "connected",
                      "error"
                    ]
                  },
                  "error": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "id",
                  "type",
                  "to",
                  "subject",
                  "body"
                ],
                "additionalProperties": true,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,100}$"
                  },
                  "type": {
                    "const": "email"
                  },
                  "to": {
                    "type": "string"
                  },
                  "subject": {
                    "type": "string"
                  },
                  "body": {
                    "type": "string"
                  },
                  "state": {
                    "type": "string"
                  },
                  "error": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "id",
                  "type",
                  "kind",
                  "title"
                ],
                "additionalProperties": true,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,100}$"
                  },
                  "type": {
                    "const": "approval"
                  },
                  "kind": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "detail": {
                    "type": "string"
                  },
                  "state": {
                    "type": "string"
                  },
                  "error": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "$comment": "Serialized card must be <= 64000 chars. Item sub-field names for todo/agenda are partly INFERRED (the kit reads x.text, x.who, x.age, x.time, x.person, x.meta, x.source, x.replyable, x.state)."
}